@baseUrl = http://localhost:8080

### 실행 준비
# 비교할 브랜치를 체크아웃한 뒤 다음 프로파일로 애플리케이션을 재시작합니다.
# SPRING_PROFILES_ACTIVE=local,mdc-repro ./gradlew bootRun
#
# before 브랜치에서 요청 실행 → 로그 캡처 → main으로 전환 → 재시작 → 같은 요청 실행 순서로 비교합니다.
# 각 실험 전에 애플리케이션을 재시작하면 이전 실험의 MDC와 인메모리 DB 상태가 초기화됩니다.

### 1-A: 요청 스레드에 userId를 남길 첫 번째 요청
GET {{baseUrl}}/api/products
X-Trace-Id: thread-user-a-0001
X-User-Id: user-A-0001

> {%
    client.test("A 상품 조회 성공", function () {
        client.assert(response.status === 200);
    });
%}

### 1-B: userId 헤더가 없는 두 번째 요청
# before-mdc-thread-cleanup: 같은 http-nio 스레드 로그에 userId=user-A-0001이 잘못 남습니다.
# main: userId가 비어 있습니다.
GET {{baseUrl}}/api/products
X-Trace-Id: thread-user-b-0002

> {%
    client.test("B 상품 조회 성공", function () {
        client.assert(response.status === 200);
    });
%}

### 2: OrderService의 MdcScope 범위 확인
# before-mdc-scope: HTTP request completed 로그까지 body-user-0003과 orderId가 남습니다.
# main: 서비스의 try-with-resources가 끝났으므로 완료 로그의 userId/orderId가 비어 있습니다.
POST {{baseUrl}}/api/orders
Content-Type: application/json
X-Trace-Id: scope-order-0003

{
  "userId": "body-user-0003",
  "productId": 1,
  "quantity": 1,
  "paymentScenario": "SUCCESS"
}

> {%
    client.test("스코프 비교용 주문 생성 성공", function () {
        client.assert(response.status === 201);
    });
%}

### 3: @Async traceId 전파 확인
# before-async-propagation: notification-1 로그의 traceId가 비어 있습니다.
# main: 요청과 notification-1 로그에 async-order-0004가 함께 찍힙니다.
POST {{baseUrl}}/api/orders
Content-Type: application/json
X-Trace-Id: async-order-0004

{
  "userId": "async-user-0004",
  "productId": 1,
  "quantity": 1,
  "paymentScenario": "SUCCESS"
}

> {%
    client.test("비동기 전파 비교용 주문 생성 성공", function () {
        client.assert(response.status === 201);
    });
%}

### 4-A: TaskDecorator 풀에 선택적 헤더 userId를 남길 요청
POST {{baseUrl}}/api/orders
Content-Type: application/json
X-Trace-Id: decorator-user-a-0005
X-User-Id: header-user-A

{
  "userId": "order-user-A",
  "productId": 1,
  "quantity": 1,
  "paymentScenario": "SUCCESS"
}

> {%
    client.test("TaskDecorator A 주문 생성 성공", function () {
        client.assert(response.status === 201);
    });
%}

### 4-B: X-User-Id가 없는 다음 비동기 요청
# OrderPaidNotificationListener의 "Async order notification received" 로그를 봅니다.
# before-task-decorator-restore: B 로그에 이전 요청의 header-user-A가 붙습니다.
# main: B 로그의 userId가 비어 있습니다.
POST {{baseUrl}}/api/orders
Content-Type: application/json
X-Trace-Id: decorator-user-b-0006

{
  "userId": "order-user-B",
  "productId": 1,
  "quantity": 1,
  "paymentScenario": "SUCCESS"
}

> {%
    client.test("TaskDecorator B 주문 생성 성공", function () {
        client.assert(response.status === 201);
    });
%}
